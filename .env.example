# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (used by compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app and Drizzle:
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

# Sign-in by a link from an email
# Random string that signs the sign-in cookie (a secret)
BETTER_AUTH_SECRET=
# Address of the site, for links in emails: http://localhost:3000 on the computer
BETTER_AUTH_URL=
# Where emails go: smtp://127.0.0.1:1025 (Mailpit) on the computer
SMTP_URL=
# Sender of emails, the whole value in single quotes
MAIL_FROM=
# Email of the owner: gets the data that existed before sign-in
OWNER_EMAIL=
